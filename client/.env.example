# REQ-0118c: Supabase Auth (self-hosted GoTrue) client config.
# These are PUBLIC client values (the anon key is a client-side credential),
# but per the project secret policy they are NOT committed -- copy this file
# to client/.env.local (gitignored) and fill in real values, or set them in
# the build environment. When absent, the sign-in UI shows "not configured"
# and the app falls back to the REQ-0037 invite/guest path.
VITE_SUPABASE_URL=https://auth.qtie.jp
VITE_SUPABASE_ANON_KEY=
