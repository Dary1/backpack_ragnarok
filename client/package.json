{
  "name": "client",
  "packageManager": "pnpm@11.10.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:sprites": "node scripts/check_sprites.mjs",
    "check:unit-icon": "node scripts/check_unit_icon.mjs",
    "check:unit-skin": "node scripts/check_unit_skin.mjs",
    "check:item-icon": "node scripts/check_item_icon.mjs",
    "check:link-trace": "node scripts/check_link_trace.mjs",
    "build:ring-preview": "node scripts/build_ring_preview.mjs",
    "e2e": "bash ../tools/e2e_run.sh",
    "e2e:failed": "bash ../tools/e2e_run.sh --last-failed",
    "e2e:changed": "bash ../tools/e2e_run.sh --only-changed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@xmldom/xmldom": "^0.8.13",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
