# backpack_ragnarok — server/.env (REQ-0040)
# Copy to server/.env (gitignored) and fill in the real values. Loaded by
# the systemd user unit via EnvironmentFile= (see server/README.md's
# "Postgres backend" section) -- api.cjs itself does not read a .env
# file directly (no dotenv dependency); these become real process env
# vars via the unit's EnvironmentFile directive.

# 'files' (default) keeps the original REQ-0024 JSON-file backend.
# 'pg' switches storage.cjs's profile persistence to the self-hosted
# Supabase Postgres instance (see ~/supabase, outside this repo).
STORAGE_BACKEND=files

# Only read when STORAGE_BACKEND=pg. Points at the dedicated 'backpack'
# role (see server/migrations/001_init.sql) via the Supavisor pooler's
# transaction-mode port, bound to 127.0.0.1 only (never public).
# Format: postgresql://backpack:<password>@127.0.0.1:6543/postgres
DATABASE_URL=postgresql://backpack:CHANGE_ME@127.0.0.1:6543/postgres

# REQ-0341: the PUBLIC Supabase client config, served to the browser by
# GET /api/config (server/routes/public.cjs). These are the same two values the
# client bundle used to inline at build time via VITE_*; they are PUBLIC client
# credentials (the anon key is designed to sit in a browser), NOT secrets.
#
# OPERATIONAL REQUIREMENT. Sign-in now depends on these being present HERE. With
# them absent or blank the route serves nulls and the sign-in UI degrades to
# "not configured" (REQ-0118c) -- the REQ-0037 invite/guest path is unaffected.
# systemd reads EnvironmentFile at START, so `systemctl --user restart
# backpack-api` is required after any change. In exchange, rotating the anon key
# needs no client rebuild and no web/app redeploy.
SUPABASE_URL=https://auth.example.invalid
SUPABASE_ANON_KEY=CHANGE_ME
